{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/magikxiii/Pictures/ASCII/Anime.txt",
    "type": "file"
  },
  "display": {
    "constants": [
      "──────────────"
    ]
  },
  "modules": [
    "title",
    "separator",
    
    // Hardware Section
    {
      "type": "custom",
      "format": "┌{$1} Hardware {$1}┐"
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "display",
    "battery",
    {
      "type": "custom",
      "format": "└{$1}────────────────{$1}┘"
    },

    "break",

    // Software Section
    {
      "type": "custom",
      "format": "┌{$1} Software {$1}┐"
    },
    "os",
    "kernel",
    "shell",
    "packages",
    "terminal",
    {
      "type": "custom",
      "format": "└{$1}────────────────{$1}┘"
    },

    "break",

    // Age Section (New)
    {
      "type": "custom",
      "format": "┌{$1} Age {$1}┐"
    },
    {
      "type": "disk",
      "key": "OS Age",
      "folders": [ "/" ],
      "format": "{days} Days"
    },
    "uptime",
    {
      "type": "custom",
      "format": "└{$1}────────────────{$1}┘"
    },

    "colors"
  ]
}   
